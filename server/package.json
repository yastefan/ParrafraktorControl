{
  "name": "@parrafraktor/server",
  "version": "0.1.0",
  "private": true,
  "description": "Server: rechnet die Pattern, sendet Art-Net/sACN, bindet Stream Deck+ und weitere Bedienungen an und liefert den PWA-Client aus",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@parrafraktor/engine": "0.1.0",
    "@parrafraktor/protokoll": "0.1.0",
    "ws": "^8.18.3"
  },
  "optionalDependencies": {
    "@elgato-stream-deck/node": "^7.3.2",
    "@napi-rs/canvas": "^0.1.80"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6"
  }
}
